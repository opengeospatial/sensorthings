{
  "@iot.id": "7b3f0e9c-2a41-4d86-8c15-f0a6e3d92b57",
  "@iot.selfLink": "https://example.org/staplus/v1.1/WriteProfiles('7b3f0e9c-2a41-4d86-8c15-f0a6e3d92b57')",
  "name": "PM2.5 low-cost sensor, v2",
  "description": "Stationary PM2.5 readings with fixed sampling intervals; no user-entered text",
  "entityTypes": [ "Thing", "Location", "Datastream", "Observation", "FeatureOfInterest" ],
  "observationTypes": [
    "http://www.opengis.net/def/observationType/OGC-OM/2.0/OM_Measurement"
  ],
  "resultCategory": "environmental",
  "freeTextPolicy": "none",
  "entitySchemas": {
    "Observation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "result": { "type": "number", "minimum": 0, "maximum": 1000 },
        "parameters": {
          "type": "object",
          "properties": { "sampling": { "enum": [ "1min", "10min" ] } },
          "additionalProperties": false
        }
      },
      "required": [ "result" ]
    },
    "Datastream": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "name": { "type": "string", "pattern": "^PM2\\.5 sensor [0-9]{1,4}$" },
        "description": { "enum": [ "Balcony", "Window", "Garden" ] },
        "properties": false
      }
    },
    "Thing": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "name": { "type": "string", "pattern": "^Sensor [A-F0-9]{8}$" },
        "description": { "const": "Low-cost PM2.5 sensor" },
        "properties": false
      }
    },
    "Location": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "name": { "const": "Sensor location" },
        "description": { "const": "Sensor location" },
        "encodingType": { "const": "application/geo+json" },
        "location": { "type": "object", "properties": { "type": { "const": "Point" } } },
        "properties": false
      }
    },
    "FeatureOfInterest": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "encodingType": { "const": "application/geo+json" },
        "properties": false
      }
    }
  },
  "clientSideProcessing": { "locationResolution": 100 },
  "creationTime": "2026-09-01T08:55:00Z",
  "status": "active",
  "Clients@iot.navigationLink": "https://example.org/staplus/v1.1/WriteProfiles('7b3f0e9c-2a41-4d86-8c15-f0a6e3d92b57')/Clients",
  "ObservedProperties@iot.navigationLink": "https://example.org/staplus/v1.1/WriteProfiles('7b3f0e9c-2a41-4d86-8c15-f0a6e3d92b57')/ObservedProperties",
  "Datastreams@iot.navigationLink": "https://example.org/staplus/v1.1/WriteProfiles('7b3f0e9c-2a41-4d86-8c15-f0a6e3d92b57')/Datastreams"
}
